APP_ENV=development
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

# Use PostgreSQL in production. SQLite is convenient for local smoke tests.
DATABASE_URL=postgresql+asyncpg://bridge:bridge@db:5432/bridge

# Set this to the self-hosted Chatwoot URL reachable from the bridge container.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_SECRET=
# Access token of a Chatwoot Agent Bot. Messages sent by the BLiP bot or BLiP Desk agents are
# mirrored into Chatwoot as outgoing messages posted by this bot. Falls back to the API token.
CHATWOOT_AGENT_BOT_TOKEN=
# Mirror phase: keep false so nothing typed in Chatwoot is ever sent to BLiP customers.
CHATWOOT_REPLIES_TO_BLIP=false
# Pilot safeguard: comma-separated Chatwoot conversation ids. When set, only replies typed in these
# conversations are forwarded to BLiP; empty means every conversation of the inbox. A malformed value
# stops the startup instead of falling back to "all".
CHATWOOT_REPLIES_ALLOWED_CONVERSATIONS=
# Assign each conversation to the BLiP Desk agent who last wrote in it, creating that agent's Chatwoot
# user when missing. Chatwoot e-mails newly created agents an invitation. Needs an administrator
# CHATWOOT_API_TOKEN; never calls BLiP.
CHATWOOT_AGENT_SYNC=false

# BLIP_CONTRACT_ID and BLIP_AUTH_KEY are only needed when the bridge calls BLiP, i.e. when
# BLIP_ACK_MESSAGES, CHATWOOT_REPLIES_TO_BLIP, BLIP_TICKET_TAG_SYNC_ENABLED or
# BLIP_AGENT_NAME_LOOKUP is true.
BLIP_CONTRACT_ID=
BLIP_AUTH_KEY=
# Key of the bot that owns the BLiP Desk (the main bot's key may have none). Used for Desk commands
# (attendants, tickets, tags); falls back to BLIP_AUTH_KEY. Value is the base64 part, without "Key ".
BLIP_DESK_AUTH_KEY=
# Main bot node (e.g. mybot@msging.net); tells customer messages from bot messages and keys the
# conversations. Any other <name>@msging.net node is also treated as a bot.
BLIP_BOT_IDENTITY=
# Optional high-entropy route token for the BLiP inbound webhook.
BLIP_INBOUND_PATH_TOKEN=
BLIP_NOTIFICATION_PATH_TOKEN=
# Send "consumed"/"failed" notifications to BLiP. Leave false when BLiP only feeds a copy of traffic.
BLIP_ACK_MESSAGES=false
BLIP_TICKET_TAG_SYNC_ENABLED=false
# With CHATWOOT_AGENT_SYNC, create the Chatwoot agent with the operator's name from BLiP Desk
# (get /attendants, read-only) instead of one derived from the e-mail. Needs BLIP_DESK_AUTH_KEY.
BLIP_AGENT_NAME_LOOKUP=false
BLIP_LABEL_POLL_SECONDS=60
# Attach BLiP media in Chatwoot (its signed URLs expire in ~30 minutes) instead of only linking it.
# Only https hosts in the comma-separated allow-list are downloaded; larger files stay a text link.
BLIP_MEDIA_ATTACHMENTS=true
BLIP_MEDIA_MAX_BYTES=20971520
BLIP_MEDIA_ALLOWED_HOSTS=blipmediastore.blob.core.windows.net
# Copy name, e-mail and a fixed set of CRM/student fields (including CPF) from BLiP contact updates
# onto the Chatwoot contact. These are personal data: see "Contact data" in the README.
BLIP_CONTACT_SYNC=true

WORKER_POLL_SECONDS=1
MAX_DELIVERY_ATTEMPTS=8
HTTP_TIMEOUT_SECONDS=15
