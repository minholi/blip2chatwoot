APP_ENV=development
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

# Use PostgreSQL in production. SQLite is convenient for local smoke tests.
DATABASE_URL=postgresql+asyncpg://bridge:bridge@db:5432/bridge

# Set this to the self-hosted Chatwoot URL reachable from the bridge container.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_SECRET=

BLIP_CONTRACT_ID=
BLIP_AUTH_KEY=
BLIP_BOT_IDENTITY=
# Optional high-entropy route token for the BLiP inbound webhook.
BLIP_INBOUND_PATH_TOKEN=
BLIP_NOTIFICATION_PATH_TOKEN=
BLIP_TICKET_TAG_SYNC_ENABLED=false
BLIP_LABEL_POLL_SECONDS=60

WORKER_POLL_SECONDS=1
MAX_DELIVERY_ATTEMPTS=8
HTTP_TIMEOUT_SECONDS=15
